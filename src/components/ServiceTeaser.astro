---
import { services } from '../content/site';
---

<section class="section services" id="services">
  <div class="container">
    <div class="intro reveal">
      <p class="section-label">Services</p>
      <h2 class="section-title">Freight modes built for Africa, Asia, and Europe</h2>
      <p class="section-lead">
        From urgent air consignments to ocean containers, road haulage, customs, and vehicle RORO —
        we plan and execute end-to-end moves with local expertise.
      </p>
    </div>

    <div class="service-list">
      {
        services.map((service, index) => (
          <a
            class="service-row reveal"
            href={service.href}
            style={`--i: ${index}`}
          >
            <div class="service-media">
              <img src={service.image} alt="" loading="lazy" width="640" height="420" />
            </div>
            <div class="service-copy">
              <h3>{service.title}</h3>
              <p>{service.short}</p>
              <span class="more">Explore service</span>
            </div>
          </a>
        ))
      }
    </div>
  </div>
</section>

<style>
  .intro {
    margin-bottom: 2.5rem;
  }

  .service-list {
    display: grid;
    gap: 1rem;
  }

  .service-row {
    display: grid;
    grid-template-columns: 1.1fr 1.4fr;
    gap: 0;
    min-height: 14rem;
    background: rgba(255, 255, 255, 0.72);
    border: 1px solid var(--line);
    overflow: hidden;
    transition:
      transform 0.3s var(--ease),
      border-color 0.3s var(--ease),
      background 0.3s var(--ease);
  }

  .service-row:hover {
    transform: translateY(-3px);
    border-color: rgba(245, 130, 32, 0.45);
    background: var(--white);
  }

  .service-media {
    position: relative;
    min-height: 12rem;
    overflow: hidden;
  }

  .service-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s var(--ease);
  }

  .service-row:hover .service-media img {
    transform: scale(1.05);
  }

  .service-copy {
    padding: 1.6rem 1.8rem;
    display: grid;
    align-content: center;
    gap: 0.55rem;
  }

  h3 {
    font-size: 1.55rem;
    margin: 0;
  }

  p {
    color: var(--muted);
    margin: 0;
  }

  .more {
    margin-top: 0.5rem;
    font-weight: 700;
    color: var(--brand-deep);
  }

  @media (max-width: 800px) {
    .service-row {
      grid-template-columns: 1fr;
    }

    .service-media {
      height: 12rem;
    }
  }
</style>

---
import { company } from '../content/site';

interface Props {
  subject?: string;
}

const { subject = 'Website contact' } = Astro.props;
const success = Astro.url.searchParams.get('sent') === '1';
---

{
  success && (
    <div class="success-banner" role="status">
      Thank you — your message has been sent. We will get back to you shortly.
    </div>
  )
}

<form class="form-grid" action={company.formEndpoint} method="POST">
  <input type="hidden" name="_subject" value={subject} />
  <input type="hidden" name="_captcha" value="false" />
  <input type="hidden" name="_next" value={new URL('/contact?sent=1', Astro.site).toString()} />
  <input type="text" name="_honey" class="hp" tabindex="-1" autocomplete="off" aria-hidden="true" />

  <div class="form-grid two">
    <div class="field">
      <label for="name">Name</label>
      <input id="name" name="name" type="text" required autocomplete="name" />
    </div>
    <div class="field">
      <label for="email">Email</label>
      <input id="email" name="email" type="email" required autocomplete="email" />
    </div>
  </div>

  <div class="field">
    <label for="message">Message</label>
    <textarea id="message" name="message" required></textarea>
  </div>

  <p class="form-note">Messages are delivered to {company.email}.</p>
  <button class="btn btn-primary" type="submit">Send message</button>
</form>

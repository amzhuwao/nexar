---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import QuoteForm from '../components/QuoteForm.astro';
---

<BaseLayout
  title="Get a Quote"
  description="Request an international freight quote from Nexar Shipping Solutions."
>
  <Hero
    compact
    headline="Get your international freight quote."
    support="Choose the type of goods you want to move and share your cargo details. Our experts will present competitive rates."
    image="/images/customs.jpg"
    primaryCta={{ label: 'Contact us', href: '/contact' }}
    secondaryCta={{ label: 'View services', href: '/#services' }}
  />

  <section class="section">
    <div class="container form-wrap reveal">
      <QuoteForm />
    </div>
  </section>
</BaseLayout>

<style>
  .form-wrap {
    max-width: 720px;
    background: rgba(255, 255, 255, 0.85);
    border: 1px solid var(--line);
    padding: 1.75rem;
  }
</style>
